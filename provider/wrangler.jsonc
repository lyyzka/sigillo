{
  "name": "sigillo-provider",
  "compatibility_date": "2026-04-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "spiceflow/cloudflare-entrypoint",
  "placement": {
    "mode": "smart",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sigillo-provider-db",
      "database_id": "b0e99e5f-7e75-4140-bbe2-073bc6dc2343",
      "migrations_dir": "./drizzle",
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://sigillo-provider.yangyangli0426.workers.dev",
    "LINGXILOOP_SSO_URL": "https://admin.lingxilearn.cn",
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "LINGXILOOP_SSO_SECRET"],
  },
}
